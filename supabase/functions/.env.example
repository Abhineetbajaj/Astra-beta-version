# Edge function secrets. For local dev, copy to supabase/functions/.env (gitignored) and run
# `supabase functions serve --env-file supabase/functions/.env`. For production, set each with
# `supabase secrets set NAME=value` — never commit real values.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the Supabase runtime (local and
# cloud) — do not set them here.

# Gemini — powers reading/chat/compatibility/financial/medical prose generation.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Rumik Silk — text-to-speech for "Listen to this reading" (get-reading-audio). Create a key at
# https://playground.rumik.ai/api-keys. Server-side only: the browser calls our own edge function,
# never Rumik directly, so this must never become a VITE_ variable or reach frontend code.
RUMIK_API_KEY=

# Razorpay — wallet top-ups and Premium subscription payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend — daily email digest (send-daily-digest). Sandboxed to your own account email until you
# verify a domain at resend.com/domains — see CLAUDE.md's setup checklist.
RESEND_API_KEY=

# Shared secret the pg_cron job sends as `x-cron-secret` to authenticate send-daily-digest (no
# Supabase session exists in a cron context). Generate with e.g. `openssl rand -hex 32`, and set
# the identical value in Supabase Vault (`vault.create_secret(..., 'cron_secret')`) that the
# scheduled cron.job's net.http_post call reads — see CLAUDE.md for the exact SQL.
CRON_SECRET=

# Frontend URL, for the "view your full dashboard" link inside the digest email.
SITE_URL=

# Web Push — send-push-notifications. Generate the pair with `npx web-push generate-vapid-keys`;
# VITE_VAPID_PUBLIC_KEY in the frontend .env must be the same public key. VAPID_SUBJECT is a
# contact URI required by the push spec (a mailto: address or your site URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
