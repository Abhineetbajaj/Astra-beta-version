# Frontend (Vite) environment. Copy to .env and fill in real values — .env is gitignored.
# Only VITE_-prefixed vars are exposed to the browser bundle; nothing secret belongs here.

# From your Supabase project settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push VAPID public key — generate the pair with `npx web-push generate-vapid-keys`. Only the
# public half goes here; the private half is a server-only Supabase secret (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
